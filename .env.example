# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
# Development only: a password that signs in to any therapist. Leave empty once there are real users.
MAGIC_PASSWORD=
# Optional "Sign in with Google" (shown only when both are set). Google Cloud console → OAuth client
# (Web application), authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI (Amit, report drafts, form conversion). Any of these; first one set wins, in this order:
#   CLAUDE_CODE_OAUTH_TOKEN  Claude.ai subscription token (sk-ant-oat…, from `claude setup-token`)
#   ANTHROPIC_API_KEY        Claude API key
#   OPENAI_API_KEY           OpenAI (also needed for dictation)
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
# Switch provider (restart needed; keep both credentials set to switch back and forth):
#   AI_PROVIDER=claude-code|anthropic|openai
# Optional:
#   EXPERT_MODEL=claude-opus-5-5            Claude model (API key or subscription)
#   EXPERT_OPENAI_MODEL=gpt-5-mini          OpenAI model
#   EMBED_PROVIDER=voyage|openai            embeddings (changing it requires pnpm corpus:build)
#   EXPERT_DAILY_LIMIT=100                  questions per cabinet per day
#
# Reports: drafts use the same provider choice (Claude preferred). Dictation needs OPENAI_API_KEY.
#   REPORT_MODEL=claude-opus-5-5            Claude model for report drafts (defaults to EXPERT_MODEL)
#   REPORT_OPENAI_MODEL=gpt-5-mini          OpenAI model for report drafts
#   REPORT_DAILY_LIMIT=200                  generations (one per recipient) per cabinet per day
#   TRANSCRIBE_MODEL=gpt-4o-transcribe      dictation
