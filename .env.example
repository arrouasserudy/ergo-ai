# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# Collègue expert (chat + literature search). Any of these; Claude and Voyage are preferred when present.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
# Optional:
#   EXPERT_PROVIDER=anthropic|openai        chat provider for new conversations
#   EXPERT_MODEL=claude-sonnet-5            Claude model
#   EXPERT_OPENAI_MODEL=gpt-5-mini          OpenAI model
#   EMBED_PROVIDER=voyage|openai            embeddings (changing it requires pnpm corpus:build)
#   EXPERT_DAILY_LIMIT=100                  questions per cabinet per day
#
# Reports: drafts use the same provider choice (Claude preferred). Dictation needs OPENAI_API_KEY.
#   REPORT_MODEL=claude-sonnet-5            Claude model for report drafts (defaults to EXPERT_MODEL)
#   REPORT_OPENAI_MODEL=gpt-5-mini          OpenAI model for report drafts
#   REPORT_DAILY_LIMIT=200                  generations (one per recipient) per cabinet per day
#   TRANSCRIBE_MODEL=gpt-4o-transcribe      dictation

# Parents' SMS meeting reminders (optional). Without a provider, the therapist sends the
# ready-made text from her own phone. Automatic sending is triggered hourly by
# .github/workflows/reminders.yml, which calls POST /api/cron/reminders with CRON_SECRET.
#   TWILIO_ACCOUNT_SID=
#   TWILIO_AUTH_TOKEN=
#   TWILIO_FROM=Ergo                        sender: alphanumeric ID (allowed in Israel) or a Twilio number
#   TWILIO_MESSAGING_SERVICE_SID=           instead of TWILIO_FROM
#   CRON_SECRET=                            openssl rand -base64 32 (also a GitHub repository secret)
#   PHONE_COUNTRY_CODE=972                  country of national numbers typed as 05X…
#
# Forms filed in children's records are stored next to the database (FILES_DIR overrides:
# defaults to <dir of DATABASE_PATH>/files, i.e. /data/files on Fly).
