{
  "name": "ergoai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "db:studio": "drizzle-kit studio",
    "db:studio-prod": "scripts/studio-prod.sh",
    "test": "vitest run",
    "corpus:fetch": "tsx scripts/corpus/fetch-pmc.ts",
    "corpus:build": "tsx --env-file-if-exists=.env.local scripts/corpus/build.ts",
    "corpus:push": "scripts/corpus/push.sh",
    "expert:search": "tsx --env-file-if-exists=.env.local scripts/expert-search.ts",
    "corpus:candidates": "tsx scripts/corpus/candidates.ts",
    "corpus:review": "tsx scripts/corpus/review-page.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "better-auth": "^1.7.5",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "docx": "^9.7.2",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.13.0",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "sqlite-vec": "^0.1.9",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.1.2"
}
